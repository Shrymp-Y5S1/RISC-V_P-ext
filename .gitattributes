# 自动检测文本文件，提交时统一转为 LF
* text=auto

# 明确标记为文本，并强制 LF
*.sh      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf

# Windows 批处理文件强制 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件
*.png     binary
*.jpg     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.tar.gz  binary